# =============================================================================
# Release signing configuration template.
#
# Copy this file to `keystore.properties` and fill in the values with your real
# signing keystore details. `keystore.properties` is ignored by git and MUST
# never be committed.
#
# This file is only used for LOCAL builds. In CI (GitHub Actions) the same
# values are supplied through GitHub Secrets:
#
#   KEYSTORE_BASE64      -> base64-encoded contents of your .jks/.keystore file
#   KEYSTORE_PASSWORD    -> the store password
#   KEY_ALIAS            -> the key alias
#   KEY_PASSWORD         -> the key password
#
# See .github/workflows/build-apk.yml and README.md for details.
# =============================================================================

# Path to your keystore file, relative to the project root.
storeFile=arenaai-release.jks

# The password used to unlock the keystore itself.
storePassword=CHANGE_ME

# The alias of the key to use for signing.
keyAlias=CHANGE_ME

# The password for the specific key.
keyPassword=CHANGE_ME
