<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.federal.arenaai">

    <!-- Standard internet/network-state access to load https://arena.ai and detect
         connectivity for the in-app error/retry screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required to run a Foreground Service at all (all target SDKs). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14+ (API 34) requires every foreground service to declare a specific
         type. ArenaSessionService does not fit any of the predefined categories (it is not
         media, location, camera, etc.) — it exists purely to keep this app's process /
         WebView session alive while the user has chosen to keep Arena AI running in the
         background, which is exactly the documented use case for "specialUse". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ (API 33) requires runtime permission to post the ongoing
         "Arena AI is running" notification that the foreground service depends on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Used only to launch the system "ignore battery optimizations" settings screen from
         an explicit, user-initiated dialog (see BatteryOptimizationHelper). This does not
         grant the exemption automatically — the user must approve it in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ArenaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArenaAi">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/launcherName"
            android:theme="@style/Theme.ArenaAi.Launch"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links to arena.ai (e.g. tapping a shared link) reopen this task instead
                 of the system browser. External domains are never matched here; MainActivity /
                 ArenaWebViewClient additionally guards navigation so only the arena.ai host is
                 ever loaded inside the WebView. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/hostName" />
            </intent-filter>
        </activity>

        <!-- Foreground Service that owns the "keep the session alive" lifecycle. It is
             started explicitly from MainActivity and only stopped by explicit user action
             (notification action, or the in-app "Close" menu item) — never merely because the
             Activity was backgrounded. See ArenaSessionService for details and honest limits. -->
        <service
            android:name=".ArenaSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's arena.ai WebView session (chat state, login, in-flight page) alive in memory while the app is backgrounded, until the user explicitly closes it." />
        </service>
    </application>
</manifest>
