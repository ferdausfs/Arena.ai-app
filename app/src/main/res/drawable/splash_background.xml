<!-- Reuses the splash bitmap assets from the previous TWA build as the cold-start window
     background: it is shown for the brief moment between process start and MainActivity's
     first frame (before the WebView has any content), then MainActivity swaps back to the
     normal theme in onCreate(). This is the standard "themed launch screen" pattern and needs
     no extra library. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/backgroundColor" />
    <item android:gravity="center" android:width="180dp" android:height="180dp">
        <bitmap android:src="@drawable/splash" android:gravity="center" />
    </item>
</layer-list>
