<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths for the Arena AI app.
    - cache-path: camera capture output + staging files handed to DownloadManager.
    - external-files-path: app-specific Downloads dir used on API 24-28 when
      WRITE_EXTERNAL_STORAGE is denied (so the "Download complete" notification
      can still open the saved file).
-->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="cache_shared" path="." />
    <external-cache-path name="external_cache_shared" path="." />
    <external-files-path name="app_downloads" path="Download/" />
    <external-files-path name="app_files" path="." />
</paths>
