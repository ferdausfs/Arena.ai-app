<resources>
    <style name="Theme.ArenaAi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Applied only for the brief cold-start window, before MainActivity.onCreate() switches
         back to Theme.ArenaAi. Reuses the splash artwork shipped with the previous build. -->
    <style name="Theme.ArenaAi.Launch" parent="Theme.ArenaAi">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
